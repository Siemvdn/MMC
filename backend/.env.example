# Kopieer dit bestand naar `.env` en vul de waarden in.
#
# `.env` staat in .gitignore en gaat NOOIT mee in Git (CLAUDE.md §11, §20).
# Op de server zet je het buiten de webroot, naast public/ — niet erin.

# Bepaalt of foutmeldingen zichtbaar zijn. Alles behalve exact "development"
# wordt als productie behandeld: dat is bewust de strengste stand, zodat een
# typefout hier nooit stack traces naar bezoekers lekt.
APP_ENV=development

# ── Admin-login ──────────────────────────────────────────────────────────────
#
# Er is één beheerder (§1). De gebruikersnaam mag hier gewoon staan; het
# wachtwoord nooit — alleen de hash ervan.
#
# De hash maak je zo, en je plakt de uitvoer hieronder:
#
#     php tools/hash-password.php
#
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ── Ondertekening van CSRF-tokens ────────────────────────────────────────────
#
# Wordt gebruikt om de tokens van het publieke contactformulier te
# ondertekenen, zodat daar geen sessie en dus geen cookie voor nodig is.
#
# Genereer een nieuwe met:
#
#     php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# Verander je deze waarde, dan worden openstaande formulieren ongeldig. Dat is
# hooguit even vervelend, nooit gevaarlijk.
APP_SECRET=

# ── Contactformulier ─────────────────────────────────────────────────────────
#
# MAIL_TO is het adres waar aanvragen naartoe gaan. MAIL_FROM moet een adres
# op het eigen domein zijn: verstuurt de server namens een vreemd domein, dan
# belandt de mail vrijwel zeker in de spammap.
MAIL_TO=
MAIL_FROM=
